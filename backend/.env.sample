# ── App ───────────────────────────────────────────────────────────────────────
ENV=dev

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: 接続文字列を直接指定（Docker Compose 等で使用）
#DATABASE_URL=postgresql://postgres:postgres@db:5432/uxcascade

# Option B: 項目ごとに指定（ローカル開発で使用）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=uxcascade

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Browser-use ───────────────────────────────────────────────────────────────
BROWSER_HEADLESS=true
