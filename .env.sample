# ── App ───────────────────────────────────────────────────────────────────────
ENV=dev
PORT=7860

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string (e.g., hosted PostgreSQL or local Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@db:5432/uxcascade

# Individual DB fields (fallback if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=uxcascade

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── MinIO / Object Storage ───────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=screenshots
MINIO_PUBLIC_URL=http://localhost:9000

# ── Browser-use ───────────────────────────────────────────────────────────────
BROWSER_HEADLESS=true
